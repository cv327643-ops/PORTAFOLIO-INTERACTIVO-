{
	admin off
	persist_config off
	auto_https off

	servers {
		trusted_proxies static private_ranges
	}
}

:{$PORT:80} {
	respond /health 200

	# Cabeceras de seguridad (alineadas con el meta CSP de index.html)
	header {
		X-XSS-Protection "1; mode=block"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "SAMEORIGIN"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "geolocation=(), microphone=(), camera=()"
		Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
		Content-Security-Policy "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; frame-src https://docs.google.com; connect-src 'self' https://docs.google.com; base-uri 'self'; form-action 'self'; frame-ancestors 'self'; object-src 'none'; upgrade-insecure-requests"
		-Server
	}

	root * .
	file_server {
		hide .git
		hide .env*
		hide Caddyfile
		hide README.md
	}

	encode {
		gzip
		zstd
	}

	try_files {path} {path}.html {path}/index.html

	handle_errors {
		rewrite * /{err.status_code}.html
		file_server
	}
}
